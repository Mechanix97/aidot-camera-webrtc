# aiDot / arnoo account
AIDOT_USER=you@example.com
AIDOT_PASSWORD=yourpassword
COUNTRY_KEY=region:UnitedStates

# name=deviceId:/path   (path is where now.png is written; optional)
CAMERAS=frente=a967aad5b6814b3dbb2ecec9d51372b7:/data/cam0,patio=b228e9b618e541479f9b4a636bdf52e0:/data/cam1

# --- continuous recording ---
RECORD_DIR=/rec           # unset to disable recording
SEGMENT_SECONDS=600       # length of each rolling segment
RECORD_FPS=12             # output framerate; keep below the camera's real fps
RECORD_CRF=26             # x264 quality (lower = bigger/better)
RETENTION_DAYS=3          # prune segments older than this (safety net)
FILL_MAX_SECONDS=300      # repeat the last frame through stalls up to this long,
                          # so video position keeps matching wall-clock time;
                          # past it, cut the segment and re-anchor
CAPTURE_LATENCY_SECONDS=0 # subtract a steady camera -> us lag from the timeline
                          # anchor; 0 unless you measure one worth correcting

# --- one file per camera per day (in-process, ~00:10 local, no cron) ---
DAILY_DIR=/daily          # unset to disable consolidation
DAILY_RETENTION_DAYS=15   # prune daily files older than this

# --- snapshots ---
SNAPSHOT_INTERVAL=5       # seconds between now.png refreshes (0 = off)
SNAPSHOT_KEEP=0           # 1 also keeps timestamped PNGs (<ts>.png)

# --- live view: re-publish to mediamtx (see docker-compose.yml) ---
RTSP_BASE=rtsp://127.0.0.1:8554
RTSP_FPS=15
# pull the camera's microphone into the live RTSP feed as G.711, which
# mediamtx hands to a browser over WebRTC without transcoding. Recordings
# stay video-only.
RTSP_AUDIO=0

LOG_LEVEL=INFO
